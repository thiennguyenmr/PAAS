# Object Storage Connection Details
# Keys for connecting to specific instances of S3/MinIO

minio_bronze:
  endpoint: "minio:9000"
  access_key: "your_minio_access_key"
  secret_key: "your_minio_secret_key"
  bucket: "bronze"

minio_silver:
  endpoint: "minio:9000"
  access_key: "your_minio_access_key"
  secret_key: "your_minio_secret_key"
  bucket: "silver"

minio_sharepoint:
  endpoint: "minio:9000"
  access_key: "your_minio_access_key"
  secret_key: "your_minio_secret_key"
  bucket: "sharepoint"
