  endpoint: "minio:9000"
  access_key: "your_access_key"
  secret_key: "your_secret_key"
  bucket: "silver"

minio_sharepoint:
  endpoint: "minio:9000"
  access_key: "your_access_key"
  secret_key: "your_secret_key"
  bucket: "sharepoint"
