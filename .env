# .env file
# ==========================================
# GLOBAL CONFIGURATION
# ==========================================
PROJECT_NAME=data-platform
NETWORK_NAME=data_network
TIMEZONE=Asia/Ho_Chi_Minh

# ==========================================
# 1. POSTGRESQL (APP DATABASE)
# ==========================================
POSTGRES_VERSION=16
POSTGRES_APP_USER=app_admin
POSTGRES_APP_PASSWORD=zyneric
POSTGRES_APP_DB=app_data
POSTGRES_APP_PORT=5432

# ===========================================
# 2. APACHE AIRFLOW
# ===========================================
# Postgres connection settings
AIRFLOW_POSTGRES_HOST=airflow-postgres
AIRFLOW_POSTGRES_PORT=5432
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# airflow environment variables
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=KTWJcMVaKj11NjMxp4Cq6nXXFZcnTrMxrMDY78cnsjk=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${AIRFLOW_POSTGRES_USER}:${AIRFLOW_POSTGRES_PASSWORD}@${AIRFLOW_POSTGRES_HOST}:${AIRFLOW_POSTGRES_PORT}/${AIRFLOW_POSTGRES_DB}
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_EMAIL=felix@malarions.com
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/ # scheduler và worker cần connect tới webserver để gọi execution API, không phải localhost
AIRFLOW__API_AUTH__JWT_SECRET=He4fJcaaeYNzcEHULEttVS51zmXZqPvFXp+t4W3+1Jo= #base64.b64encode(os.urandom(32)).decode('utf-8')
AIRFLOW__API__SECRET_KEY=86516c00daa572053fe72fece9fed4bc8867441b952eade207fdf938a28389dd # secrets.token_hex(32)
AIRFLOW__WEBSERVER__SECRET_KEY=69842aa75aa418d081551e410a731b00ab7090a64a6c2e013df824e03eaeda25 # secrets.token_hex(32)

# Simple auth manager config
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=${AIRFLOW_ADMIN_USERNAME}:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/simple_auth_manager_passwords.json.generated

PYTHONPATH=/opt/airflow/modules:/opt/airflow/scripts

# ==========================================
# 3. APACHE SPARK CLUSTER
# ==========================================
SPARK_VERSION=3.5.0
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_WEBUI_PORT=8082

# ==========================================
# 4. MINIO (OBJECT STORAGE - S3 Compatible)
# ==========================================
MINIO_VERSION=latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=datalake
MINIO_ENDPOINT_URL=minio:9000

SWAGGER_HOST=10.130.0.3:6061

# ==========================================
# 5. MILVUS (VECTOR DATABASE)
# ==========================================
MILVUS_VERSION=v2.3.4
ETCD_VERSION=v3.5.5
MILVUS_PORT=19530

# ==========================================
# 6. NEO4J (GRAPH DATABASE)
# ==========================================
NEO4J_VERSION=5.15.0
# Port HTTP (Web Browser)
NEO4J_HTTP_PORT=7474
# Port Bolt (kết nối code)
NEO4J_BOLT_PORT=7687
# Auth: user/password (mặc định user là neo4j)
NEO4J_AUTH=neo4j/graph_secret_password


