# .env.example
# Copy this file to .env and update the values
# ==========================================
# GLOBAL CONFIGURATION
# ==========================================
PROJECT_NAME=data-platform
NETWORK_NAME=data_network
TIMEZONE=Asia/Ho_Chi_Minh

# ==========================================
# HOST PORT CONFIGURATION
# ==========================================
# ----------------------------------
# Storage: 6000 -> 6019
# ----------------------------------
# MinIO 6000->6001
MINIO_SERVER_HOST_PORT=6000
MINIO_UI_HOST_PORT=6001

# Postgres application database
APP_POSTGRES_HOST_PORT=6003

# Milvus 6005 -> 6006
MILVUS_GRPC_HOST_PORT=6005
MILVUS_UI_HOST_PORT=6006

# Neo4j 6007 -> 6008
NEO4J_HTTP_HOST_PORT=6007
NEO4J_BOLT_HOST_PORT=6008

# ----------------------------------
# Processing: 6020 -> 6039
# ----------------------------------
# Spark 6020 -> 6022
SPARK_MASTER_HOST_PORT=6020
SPARK_UI_HOST_PORT=6021
SPARK_HISTORY_SERVER_HOST_PORT=6022

# Airflow 6030-6033
AIRFLOW_POSTGRE_HOST_PORT=6030
AIRFLOW_WEBSERVER_HOST_PORT=6031
AIRFLOW_POSTGRES_PORT=6032

# MLflow 6035-6037
MLFLOW_HOST_PORT=6035
MLFLOW_OAUTH_PROXY_PORT=6036
MLFLOW_POSTGRES_HOST_PORT=6037

# ----------------------------------
# Monitoring: 6050 -> 6059
# ----------------------------------
CADVISOR_HOST_PORT=6050
PROMETHEUS_HOST_PORT=6051
GRAFANA_HOST_PORT=6052
GRAFANA_IMAGE_RENDERER_HOST_PORT=6053
ALERTMANAGER_HOST_PORT=6054

# SMTP (Brevo - https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_LOGIN=your_smtp_login@smtp-brevo.com
BREVO_SMTP_KEY=your_smtp_key
ALERT_EMAIL_FROM=your_email@example.com
ALERT_EMAIL_TO=recipient@example.com

# ----------------------------------
# Security: 6060 -> 6069
# ----------------------------------
VAULT_HOST_PORT=6060
KEYCLOAK_HOST_PORT=6061

# ----------------------------------
# OAuth2 Proxy (for services without native OAuth)
# ----------------------------------
SPARK_OAUTH_PROXY_PORT=6025
SPARK_HISTORY_OAUTH_PROXY_PORT=6026
OAUTH2_PROXY_COOKIE_SECRET=generate-a-32-byte-secret-here!

# ==========================================
# SERVICE CONFIGURATION
# ==========================================
# ----------------------------------
# 1. POSTGRESQL (APP DATABASE)
# ----------------------------------
POSTGRES_VERSION=16
POSTGRES_APP_USER=app_admin
POSTGRES_APP_PASSWORD=your_postgres_password
POSTGRES_APP_DB=app_data
POSTGRES_APP_PORT=5432

# ----------------------------------
# 2. APACHE AIRFLOW
# ----------------------------------
# Postgres connection settings
AIRFLOW_POSTGRES_HOST=airflow-postgres
AIRFLOW_POSTGRES_PORT=5432
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=your_airflow_db_password
AIRFLOW_POSTGRES_DB=airflow

# Airflow environment variables
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_base64_encoded
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${AIRFLOW_POSTGRES_USER}:${AIRFLOW_POSTGRES_PASSWORD}@${AIRFLOW_POSTGRES_HOST}:${AIRFLOW_POSTGRES_PORT}/${AIRFLOW_POSTGRES_DB}
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_secret_base64_encoded
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
AIRFLOW__API_AUTH__JWT_EXPIRATION_TIME_SECONDS=3600
AIRFLOW__API__SECRET_KEY=your_api_secret_key
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:6031
KEYCLOAK_AIRFLOW_CLIENT_ID=airflow

# Auth Manager: Choose one
# Option 1: SimpleAuth (local users) - DISABLED
# AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=${AIRFLOW_ADMIN_USERNAME}:admin
# AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/simple_auth_manager_passwords.json.generated

# Option 2: FAB Auth Manager (Keycloak OAuth) - DISABLED
# AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
# AIRFLOW__WEBSERVER__CONFIG_FILE=/opt/airflow/_config/webserver_config.py

# Option 3: Keycloak Auth Manager (Native SSO) - ENABLED
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.keycloak.auth_manager.keycloak_auth_manager.KeycloakAuthManager
AIRFLOW__KEYCLOAK_AUTH_MANAGER__CLIENT_ID=${KEYCLOAK_AIRFLOW_CLIENT_ID}
AIRFLOW__KEYCLOAK_AUTH_MANAGER__CLIENT_SECRET=${KEYCLOAK_AIRFLOW_CLIENT_SECRET}
AIRFLOW__KEYCLOAK_AUTH_MANAGER__REALM=${KEYCLOAK_REALM}
AIRFLOW__KEYCLOAK_AUTH_MANAGER__SERVER_URL=${KEYCLOAK_EXTERNAL_URL}

# Vault Secrets Backend
AIRFLOW__SECRETS__BACKEND=airflow.providers.hashicorp.secrets.vault.VaultBackend
AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_path": "airflow/connections", "variables_path": "airflow/variables", "url": "http://vault:8200", "auth_type": "token", "token": "your-vault-token", "mount_point": "secret"}

# ----------------------------------
# 3. APACHE SPARK CLUSTER
# ----------------------------------
SPARK_VERSION=3.5.0
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_WEBUI_PORT=8082

# ----------------------------------
# 4. MINIO (OBJECT STORAGE - S3 Compatible)
# ----------------------------------
MINIO_VERSION=latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_DEFAULT_BUCKET=datalake
MINIO_ENDPOINT_URL=minio:9000

SWAGGER_HOST=your_host_ip:6061

# ----------------------------------
# 5. MILVUS (VECTOR DATABASE)
# ----------------------------------
MILVUS_VERSION=v2.3.4
ETCD_VERSION=v3.5.5
MILVUS_PORT=19530

# ----------------------------------
# 6. NEO4J (GRAPH DATABASE)
# ----------------------------------
NEO4J_AUTH=neo4j/your_neo4j_password
NEO4J_PASSWORD=your_neo4j_password

# ----------------------------------
# 7. HASHICORP VAULT (SECRET MANAGEMENT)
# ----------------------------------
# Mode: "dev" (in-memory, credentials regenerate) or "production" (persistent)
VAULT_MODE=production
VAULT_DEV_ROOT_TOKEN=your-vault-root-token
VAULT_ADDR=http://vault:8200
# AppRole credentials (generated by setup-auth.sh on first Vault startup)
# In production mode, these persist across restarts
VAULT_AIRFLOW_ROLE_ID=your-airflow-role-id
VAULT_AIRFLOW_SECRET_ID=your-airflow-secret-id
VAULT_GRAFANA_ROLE_ID=your-grafana-role-id
VAULT_GRAFANA_SECRET_ID=your-grafana-secret-id

# ----------------------------------
# 8. KEYCLOAK (IDENTITY MANAGEMENT)
# ----------------------------------
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password
KEYCLOAK_DB_NAME=keycloak

# Keycloak OIDC Configuration
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:${KEYCLOAK_HOST_PORT}
KEYCLOAK_REALM=paas

# Keycloak OIDC Client Secrets (per-service authentication)
KEYCLOAK_AIRFLOW_CLIENT_SECRET=your-airflow-client-secret
KEYCLOAK_GRAFANA_CLIENT_SECRET=your-grafana-client-secret
KEYCLOAK_MINIO_CLIENT_SECRET=your-minio-client-secret
KEYCLOAK_SPARK_CLIENT_SECRET=your-spark-client-secret
KEYCLOAK_MLFLOW_CLIENT_SECRET=your-mlflow-client-secret

# ----------------------------------
# 9. MLFLOW (ML EXPERIMENT TRACKING)
# ----------------------------------
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=your_mlflow_db_password
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_S3_BUCKET=mlflow
